# .backupignore — exclusion list for sovereign local backups
# Everything here is excluded from safety tarballs.

# VCS & environments (rebuildable)
.git
*/.git/*
.venv
*/.venv/*
.venv.*
*/.venv.*/*
.aider-venv
*/.aider-venv/*
venv
*/venv/*
node_modules
*/node_modules/*
__pycache__
*/__pycache__/*
*.pyc
.cache
*/.cache/*
unsloth_compiled_cache
*/unsloth_compiled_cache/*

# Secrets
.env
.env.*

# Logs, build output, prior backups
.logs
*/.logs/*
Build
*/Build/*
Builds
*/Builds/*
build
*/build/*
dist
*/dist/*
backups
*/backups/*
Archive
*/Archive/*
backup.log
*.log

# Unity generated trees & caches
Library
*/Library/*
*Library*
PackageCache
*/PackageCache/*
Temp
*/Temp/*
Logs
*/Logs/*
obj
*/obj/*
webvm_source
*/webvm_source/*
client_quest
*/client_quest/*

# Large binary assets, datasets, disk images
Animations/BVH
*/Animations/*
*/Bandai-Namco*/*
Bandai-Namco*
custom-disk-images
*/custom-disk-images/*
media
*/media/*
*.gguf
*.pak
*.bin
*.safetensors
*.apk
*.ext2

# Model weights caches & heavy tool binaries
models
*/models/*
xrl_encoded
*/xrl_encoded/*
llama-b11053*
*/llama-b11053*/*
llama-bins.tar.gz
foveai-omni-router-v2.xrlf.cache
*/foveai-omni-router-v2.xrlf.cache/*

# Windows reserved device names
nul
nulcmd
