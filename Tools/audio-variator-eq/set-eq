def load_state() -> dict:
    state = dict(DEFAULT_STATE)
    if STATE_PATH.exists():
        try:
            state.update(json.loads(STATE_PATH.read_text(encoding="utf-8")))
        except Exception:
            pass
    return state


def save_state(state: dict):
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state, indent=2), encoding="utf-8")


def load_presets() -> dict:
    presets = {"scenes": dict(FACTORY_SCENES),
               "units": {u: dict(ps) for u, ps in FACTORY_UNIT_PRESETS.items()},
               "cats": {}}
    if PRESETS_PATH.exists():
        try:
            saved = json.loads(PRESETS_PATH.read_text(encoding="utf-8"))
            presets["scenes"].update(saved.get("scenes", {}))
            for unit, ps in saved.get("units", {}).items():
                presets["units"].setdefault(unit, {}).update(ps)
        except Exception:
            pass
    for name, sc in presets["scenes"].items():
        presets["cats"][name] = sc.get("cat", "CUSTOM") if isinstance(sc, dict) else "CUSTOM"
    # educational commentary: factory atom blurbs + per-scene edu fields
    presets["edu"] = {
        "units": {u: dict(edu) for u, edu in FACTORY_UNIT_EDU.items()},
        "scenes": {n: sc.get("edu", "") for n, sc in presets["scenes"].items()
                   if isinstance(sc, dict)},
    }
    return presets


def save_presets(presets: dict):
    # keep factory scenes and factory unit atoms out of the file; only user
    # saves are persisted
    user_scenes = {k: v for k, v in presets.get("scenes", {}).items()
                   if k not in FACTORY_SCENES or v != FACTORY_SCENES[k]}
    user_units = {}
    for unit, ps in presets.get("units", {}).items():
        keep = {n: v for n, v in ps.items()
                if n not in FACTORY_UNIT_PRESETS.get(unit, {})
                or v != FACTORY_UNIT_PRESETS[unit][n]}
        if keep:
            user_units[unit] = keep
    PRESETS_PATH.parent.mkdir(parents=True, exist_ok=True)
    PRESETS_PATH.write_text(json.dumps({"scenes": user_scenes, "units": user_units}, indent=2),
                            encoding="utf-8")


def resolve_scene(scene: dict, units: dict) -> dict:
    """Expand a scene's unit-preset references into raw state keys.

    A scene is {"cat": ..., "units": {"EQ": "COLD SCOOP", ...}} — each value is
    a unit preset name (or a list of names merged in order). Raw keys at the
    top level override the resolved preset values. Plain value dicts (user-
    saved snapshots) pass through unchanged.
    """
    vals = {}
    if isinstance(scene, dict):
        for unit, ref in scene.get("units", {}).items():
            for name in (ref if isinstance(ref, list) else [ref]):
                p = units.get(unit, {}).get(name, {})
                for k, v in p.items():
                    if k in UNIT_KEYS.get(unit, ()):
                        vals[k] = v
        for k, v in scene.items():
            if k not in ("units", "cat", "desc", "edu"):
                vals[k] = v
    return vals


def get_eq_node_id() -> int:
    try:
        out = subprocess.check_output(["pw-dump"], timeout=2).decode()
        for obj in json.loads(out):
            if obj.get("type") == "PipeWire:Interface:Node":
                props = obj.get("info", {}).get("props", {})
                if props.get("node.name") == "effect_input.eq":
                    return obj["id"]
    except Exception:
        pass
    return None


def set_live_prop(node_id: int, param_name: str, val):
    if not node_id:
        return
    payload = json.dumps({"params": [param_name, val]})
    subprocess.run(["pw-cli", "s", str(node_id), "Props", payload],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _set_both(node_id: int, fmt: str, val):
    for s in SIDES:
        set_live_prop(node_id, fmt.format(s=s), val)


def _apply_bypass(node_id: int):
    for s in SIDES:
        for band in range(1, 6):
            set_live_prop(node_id, f"eq_band_{band}_{s}:Gain", 0.0)
        set_live_prop(node_id, f"eq_band_4_{s}:Freq", 3500.0)
        set_live_prop(node_id, f"pitch_{s}:Pitch shift", 1.0)
        set_live_prop(node_id, f"detune_{s}:Pitch shift", 1.0)
        set_live_prop(node_id, f"detune2_{s}:Pitch shift", 1.0)
        for g in range(2, 9):
            set_live_prop(node_id, f"mix_{s}:Gain {g}", 0.0)
    _set_both(node_id, "comp_{s}:Threshold", 0.0)
    _set_both(node_id, "comp_{s}:Ratio", 1.0)
    _set_both(node_id, "comp_{s}:Makeup", 0.0)


def apply_all_live(state: dict):
    node_id = get_eq_node_id()
    if not node_id:
        return

    if state.get("bypass", False):
        _apply_bypass(node_id)
        return

    b_low = state.get("bal_low", "neutral")
    b_high = state.get("bal_high", "neutral")
    loud = float(state.get("loudness", 0.0))
    mod = float(state.get("modulator", 0.0))

    # Dual Frequency Balancer offsets
    bass_bias = +2.0 if b_low == "low" else (-1.0 if b_low == "mid" else 0.0)
    mid_low_bias = +1.5 if b_low == "mid" else (-1.0 if b_low == "low" else 0.0)
    mid_high_bias = +1.5 if b_high == "mid" else (-1.0 if b_high == "high" else 0.0)
    treb_bias = +2.0 if b_high == "high" else (-1.0 if b_high == "mid" else 0.0)

    # Loudness contour (+0 to +5 dB)
    loud_bass = (loud / 100.0) * 5.0
    loud_treble = (loud / 100.0) * 4.0

    eff_bass = state["bass"] + bass_bias + loud_bass
    eff_mid = state["mid"] + mid_low_bias + mid_high_bias
    eff_treble = state["treble"] + treb_bias + loud_treble

    bf = min(500.0, max(20.0, float(state.get("bass_freq", 100.0))))
    mf = min(8000.0, max(200.0, float(state.get("mid_freq", 1000.0))))
    tf = min(16000.0, max(1500.0, float(state.get("treble_freq", 8000.0))))
    bq = min(8.0, max(0.3, float(state.get("bass_q", 1.0))))
    mq = min(8.0, max(0.3, float(state.get("mid_q", 1.0))))
    tq = min(8.0, max(0.3, float(state.get("treble_q", 1.0))))

    for s in SIDES:
        set_live_prop(node_id, f"eq_band_1_{s}:Gain", round(eff_bass, 1))
        set_live_prop(node_id, f"eq_band_1_{s}:Freq", round(bf, 1))
        set_live_prop(node_id, f"eq_band_1_{s}:Q", round(bq, 2))
        set_live_prop(node_id, f"eq_band_3_{s}:Gain", round(eff_mid, 1))
        set_live_prop(node_id, f"eq_band_3_{s}:Freq", round(mf, 1))
        set_live_prop(node_id, f"eq_band_3_{s}:Q", round(mq, 2))
        set_live_prop(node_id, f"eq_band_5_{s}:Gain", round(eff_treble, 1))
        set_live_prop(node_id, f"eq_band_5_{s}:Freq", round(tf, 1))
        set_live_prop(node_id, f"eq_band_5_{s}:Q", round(tq, 2))

        # Freq Modulator: real swept peaking band (300 Hz -> 5 kHz, up to +7 dB)
        mod_freq = 300.0 + (mod / 100.0) * 4700.0
        mod_gain = (mod / 100.0) * 7.0 * (1.0 if b_high == "high" else 0.7)
        set_live_prop(node_id, f"eq_band_4_{s}:Freq", round(mod_freq, 0))
        set_live_prop(node_id, f"eq_band_4_{s}:Gain", round(mod_gain, 1))

        # Pitch & Warp: semitones -> ratio (AM pitchshifter, real-time)
        pitch_st = int(state.get("pitch", 0))
        warp_cents = float(state.get("warp", 0.0))
        set_live_prop(node_id, f"pitch_{s}:Pitch shift",
                      round(2.0 ** ((pitch_st + warp_cents / 100.0) / 12.0), 4))

        # Reverb: quadratic taper split between room (Gain 2) and cathedral (Gain 6)
        rv = float(state.get("reverb", 0.0)) / 100.0
        rt = state.get("reverb_type", "room")
        wetA, wetB = {"room": (1.0, 0.0), "plate": (0.55, 0.65), "cath": (0.0, 1.0)}.get(rt, (1.0, 0.0))
        set_live_prop(node_id, f"mix_{s}:Gain 2", round(rv * rv * 0.35 * wetA, 4))
        set_live_prop(node_id, f"mix_{s}:Gain 6", round(rv * rv * 0.50 * wetB, 4))

        # Echo delay: level -> Gain 7, division -> per-side delay times
        dl = float(state.get("delay", 0.0)) / 100.0
        dtimes = {"slap": (0.09, 0.09), "1/8": (0.25, 0.25), "trip": (0.33, 0.33),
                  "1/4": (0.50, 0.50), "ping": (0.22, 0.45)}.get(state.get("delay_type", "1/8"), (0.25, 0.25))
        set_live_prop(node_id, f"del_{s}:Delay (s)", dtimes[0] if s == "l" else dtimes[1])
        set_live_prop(node_id, f"mix_{s}:Gain 7", round(dl * 0.5, 3))

        # Chorus voices: duet = one detune voice, trio = +second voice, vib = wide cents
        chor = float(state.get("chorus", 0.0)) / 100.0
        ctype = state.get("chorus_type", "duet")
        depth = 16.0 if ctype == "vib" else 7.0
        cents = depth if s == "l" else -depth
        set_live_prop(node_id, f"detune_{s}:Pitch shift", round(2.0 ** (cents / 1200.0), 5))
        set_live_prop(node_id, f"mix_{s}:Gain 3", round(chor * 0.6, 3))
        set_live_prop(node_id, f"mix_{s}:Gain 8", round(chor * (0.4 if ctype == "trio" else 0.0), 3))

        # Stereo width: M/S side boost + delayed crossfeed (surround zone > 50%)
        w = float(state.get("width", 0.0)) / 100.0
        set_live_prop(node_id, f"mix_{s}:Gain 4", round(w * 0.7, 3))
        set_live_prop(node_id, f"mix_{s}:Gain 5", round(max(0.0, w - 0.5) * 0.6, 3))

    # Bus compressor (FoveAI fove_comp LADSPA pedal)
    comp = float(state.get("compressor", 0.0)) / 100.0
    _set_both(node_id, "comp_{s}:Threshold", round(-comp * 20.0, 1))
    _set_both(node_id, "comp_{s}:Ratio", round(1.0 + comp * 3.0, 2))
    _set_both(node_id, "comp_{s}:Makeup", round(comp * 6.0, 1))


def main():
    parser = argparse.ArgumentParser(description="PipeWire Live EQ, Dual Balancers & Pitch Engine")
    parser.add_argument("--json", action="store_true", help="Output current state as JSON")
    parser.add_argument("--status", action="store_true", help="Show text status")
    parser.add_argument("--bypass", choices=["on", "off"], help="Master FX bypass on/off")
    parser.add_argument("--toggle-bypass", action="store_true", help="Toggle master FX bypass")
    parser.add_argument("--bass", type=float, help="Bass gain in dB (-12 to +12)")
    parser.add_argument("--mid", type=float, help="Mid gain in dB (-12 to +12)")
    parser.add_argument("--treble", type=float, help="Treble gain in dB (-12 to +12)")
    parser.add_argument("--bass-freq", type=float, help="Bass shelf freq Hz (20-500)")
    parser.add_argument("--mid-freq", type=float, help="Mid peak freq Hz (200-8000)")
    parser.add_argument("--treble-freq", type=float, help="Treble shelf freq Hz (1500-16000)")
    parser.add_argument("--bass-q", type=float, help="Bass band Q (0.3-8)")
    parser.add_argument("--mid-q", type=float, help="Mid band Q (0.3-8)")
    parser.add_argument("--treble-q", type=float, help="Treble band Q (0.3-8)")
    parser.add_argument("--pitch", type=int, help="Pitch shift in semitones (-12 to +12)")
    parser.add_argument("--warp", type=float, help="Warp / fine glide in cents (-100 to +100)")
    parser.add_argument("--bal-low", choices=["neutral", "low", "mid"], help="Low balancer")
    parser.add_argument("--bal-high", choices=["neutral", "mid", "high"], help="High balancer")
    parser.add_argument("--toggle-bal-low", action="store_true", help="Cycle low balancer")
    parser.add_argument("--toggle-bal-high", action="store_true", help="Cycle high balancer")
    parser.add_argument("--loudness", type=float, help="Loudness contour (0-100 %)")
    parser.add_argument("--compressor", type=float, help="Compressor level (0-100 %)")
    parser.add_argument("--reverb", type=float, help="Reverb level (0-100 %)")
    parser.add_argument("--reverb-type", choices=["room", "plate", "cath"], help="Reverb character")
    parser.add_argument("--delay", type=float, help="Echo level (0-100 %)")
    parser.add_argument("--delay-type", choices=["slap", "1/8", "1/4", "trip", "ping"], help="Echo division")
    parser.add_argument("--chorus-type", choices=["duet", "trio", "vib"], help="Chorus voices/depth")
    parser.add_argument("--chorus", type=float, help="Chorus level (0-100 %)")
    parser.add_argument("--modulator", type=float, help="Frequency modulator (0-100 %)")
    parser.add_argument("--width", type=float, help="Stereo width / surround sim (0-100 %)")
    parser.add_argument("--reset", action="store_true", help="Reset all controls to flat / default")
    parser.add_argument("--presets-json", action="store_true", help="Output all presets as JSON")
    parser.add_argument("--preset", type=str, help="Apply a scene preset by name")
    parser.add_argument("--save-preset", type=str, help="Save current state as a scene preset")
    parser.add_argument("--unit-preset", nargs=2, metavar=("UNIT", "NAME"), help="Apply a unit preset")
    parser.add_argument("--save-unit-preset", nargs=2, metavar=("UNIT", "NAME"), help="Save current unit settings as a preset")
    parser.add_argument("--delete-preset", type=str, help="Delete a user scene preset")

    args = parser.parse_args()
    state = load_state()

    if args.json:
        print(json.dumps(state))
        return

    if args.presets_json:
        print(json.dumps(load_presets()))
        return

    if args.save_preset:
        presets = load_presets()
        presets["scenes"][args.save_preset] = state
        save_presets(presets)
        print(f"Saved scene preset '{args.save_preset}'.")
        return

    if args.save_unit_preset:
        unit, name = args.save_unit_preset
        if unit not in UNIT_KEYS:
            print(f"Unknown unit '{unit}'. Units: {', '.join(UNIT_KEYS)}", file=sys.stderr)
            sys.exit(1)
        presets = load_presets()
        presets["units"].setdefault(unit, {})[name] = {k: state.get(k) for k in UNIT_KEYS[unit]}
        save_presets(presets)
        print(f"Saved {unit} preset '{name}'.")
        return

    if args.delete_preset:
        presets = load_presets()
        if args.delete_preset in presets["scenes"]:
            del presets["scenes"][args.delete_preset]
            save_presets(presets)
            print(f"Deleted preset '{args.delete_preset}'.")
        return

    if args.preset:
        presets = load_presets()
        if args.preset not in presets["scenes"]:
            print(f"Unknown preset '{args.preset}'. Have: {', '.join(presets['scenes'])}", file=sys.stderr)
            sys.exit(1)
        # a scene is a complete deterministic state: start from defaults so
        # values from a previous scene can't bleed through, keep bypass as-is
        state = dict(DEFAULT_STATE)
        state["bypass"] = load_state().get("bypass", False)
        state.update(resolve_scene(presets["scenes"][args.preset], presets["units"]))
        save_state(state)
        apply_all_live(state)
        print(f"Applied scene '{args.preset}'.")
        return

    if args.unit_preset:
        unit, name = args.unit_preset
        presets = load_presets()
        p = presets["units"].get(unit, {}).get(name)
        if p is None:
            print(f"Unknown {unit} preset '{name}'.", file=sys.stderr)
            sys.exit(1)
        state.update(p)
        save_state(state)
        apply_all_live(state)
        print(f"Applied {unit} preset '{name}'.")
        return

    if args.reset:
        state = dict(DEFAULT_STATE)
        save_state(state)
        apply_all_live(state)
        print("Reset all EQ, Pitch & effects to default.")
        return

    changed = False

    if args.toggle_bypass:
        state["bypass"] = not state.get("bypass", False)
        changed = True

    if args.bypass:
        state["bypass"] = args.bypass == "on"
        changed = True

    if args.toggle_bal_low:
        order = ["neutral", "low", "mid"]
        cur = state.get("bal_low", "neutral")
        state["bal_low"] = order[(order.index(cur) + 1) % len(order)]
        changed = True

    if args.toggle_bal_high:
        order = ["neutral", "mid", "high"]
        cur = state.get("bal_high", "neutral")
        state["bal_high"] = order[(order.index(cur) + 1) % len(order)]
        changed = True

    if args.bal_low:
        state["bal_low"] = args.bal_low
        changed = True

    if args.bal_high:
        state["bal_high"] = args.bal_high
        changed = True

    for param in ["reverb_type", "delay_type", "chorus_type"]:
        val = getattr(args, param, None)
        if val is not None:
            state[param] = val
            changed = True

    for param in ["bass", "mid", "treble", "pitch", "warp", "loudness",
                  "compressor", "reverb", "chorus", "modulator", "width",
                  "bass_freq", "mid_freq", "treble_freq", "bass_q", "mid_q", "treble_q",
                  "delay"]:
        val = getattr(args, param, None)
        if val is not None:
            state[param] = val
            changed = True

    if changed:
        save_state(state)
        apply_all_live(state)

    if args.status or changed or len(sys.argv) == 1:
        print(f"--- PipeWire Audio State ---")
        print(f"  FX Engine:   {'BYPASSED' if state.get('bypass') else 'ACTIVE':>8s}")
        print(f"  Pitch:       {state['pitch']:>+3d} st")
        print(f"  Warp:        {state['warp']:>+5.1f} ct")
        print(f"  Bass:        {state['bass']:>+5.1f} dB")
        print(f"  Freq.Bal.Low:{state['bal_low'].upper():>8s}")
        print(f"  Mid:         {state['mid']:>+5.1f} dB")
        print(f"  Freq.Bal.Hi: {state['bal_high'].upper():>8s}")
        print(f"  Treble:      {state['treble']:>+5.1f} dB")
        print(f"  Loudness:    {state['loudness']:>5.0f} %")
        print(f"  Compressor:  {state['compressor']:>5.0f} %")
        print(f"  Chorus:      {state['chorus']:>5.0f} %")
        print(f"  Reverb:      {state['reverb']:>5.0f} %")
        print(f"  Modulator:   {state['modulator']:>5.0f} %")
        print(f"  S.Width:     {state['width']:>5.0f} %")


if __name__ == "__main__":
    main()
