            <div class="empty-state-btn-row" style="margin-top: 16px; display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; max-width: 400px; margin-left: auto; margin-right: auto; padding-top: 6px;">
              <button type="button" id="btn-start-new" class="toolbar-btn" style="font-size: 12px; padding: 6px 16px; font-weight: 600; background: var(--accent); color: white; border: none; border-radius: 6px; box-shadow: 0 4px 10px rgba(14, 99, 156, 0.4);">✨ New</button>
