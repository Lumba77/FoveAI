      padding: 10px;
    }

    /* ── INPUT TOOLBAR (quick-action bar above the text input) ───────────────────────────────────── */
    #input-toolbar {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 4px 6px 6px 6px;
    }
    .toolbar-btn {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: color-mix(in srgb, var(--bg-panel) 60%, transparent);
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
      white-space: nowrap;
    }
    .toolbar-btn:hover {
      background: var(--bg-glass-hover);
      color: var(--text-primary);
      border-color: var(--text-muted);
    }
    .toolbar-btn-danger {
      border-color: rgba(239, 68, 68, 0.35);
      color: #f87171;
      background: rgba(239, 68, 68, 0.08);
    }
    .toolbar-btn-danger:hover {
      background: rgba(239, 68, 68, 0.18);
      border-color: rgba(239, 68, 68, 0.6);
      color: #fca5a5;
    }
    #toolbar-problem-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(239, 68, 68, 0.7);
      color: white;
      border-radius: 8px;
      font-size: 10px;
      font-weight: 700;
      padding: 0 5px;
      min-width: 16px;
      height: 16px;
      margin-left: 2px;
      display: none;
    }
    .toolbar-sep {
      width: 1px;
      height: 14px;
      background: var(--border);
      margin: 0 2px;
      flex-shrink: 0;
    }
    #input-wrap {
      display: flex !important;
      background: var(--vscode-input-background, #252526) !important;
      border: 1px solid var(--border) !important;
      border-radius: 18px !important;
      padding: 4px 6px 4px 12px !important;
      margin: 0 10px 4px 10px !important;
      align-items: flex-end !important;
      gap: 6px !important;
      box-sizing: border-box !important;
      transition: border-color 0.2s, box-shadow 0.2s !important;
      position: relative !important;
    }
    #input-wrap:focus-within {
      border-color: var(--vscode-focusBorder, #007fd4) !important;
      box-shadow: 0 0 0 1px var(--vscode-focusBorder, #007fd4) !important;
    }
    /* Send button anchored to the right inside the input wrap */
    #input-wrap #send-btn {
      flex-shrink: 0 !important;
      align-self: flex-end !important;
      margin-bottom: 2px !important;
    }
    
    #chat-input {
      flex: 1 !important;
      background: transparent !important;
      border: none !important;
      color: var(--text-primary) !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
      font-size: 11.5px !important;
      line-height: 1.35 !important;
      resize: none !important;
      outline: none !important;
      min-height: 32px !important;
      max-height: 180px !important;
      padding: 2px 0 !important;
      margin: 0 !important;
      box-sizing: border-box !important;
      display: block !important;
      overflow-y: auto !important;
