        </div>
        <div id="stats-modal-body" class="modal-body">Loading statistics...</div>
      </div>

      <!-- Ingredients Modal Popover -->
      <div id="ingredients-modal" class="modal-popover">
        <div class="flex-between-center modal-header">
          <span class="modal-title">📜 Session Ingredients Index</span>
          <button type="button" id="close-modal-btn" class="modal-close-btn" aria-label="Close Index">✕</button>
        </div>
        <div id="ingredients-modal-body" class="modal-body">Loading ingredients index...</div>
      </div>

      <div id="messages">
        <!-- Task Board — auto-populated from chat checkboxes -->
        <div id="task-board" class="task-board-hidden">
          <div id="task-board-header">
            <div id="task-board-title">
              ☑ Tasks
              <span id="task-board-badge">0</span>
            </div>
            <span id="task-board-toggle">▾</span>
          </div>
          <div id="task-board-body">
            <div id="task-board-empty">No active tasks — tasks from chat will appear here</div>
          </div>
          <div id="task-board-footer">
            <span class="task-board-action-btn" id="task-clear-done">Clear Done</span>
            <span class="task-board-action-btn" id="task-clear-all">Clear All</span>
          </div>
        </div>

        <!-- Default State: Empty Hero & Accordion -->
        <div id="empty-state">
          <div id="empty-state-hero" class="empty-state-hero">
            <h2 style="font-family: 'Outfit', sans-serif;">FoveAI Vibe Coder</h2>
            <div id="workspace-context" class="workspace-context" style="max-width: 480px;">
              <div class="workspace-context-grid" id="executional-points-grid">
                <!-- Tile 1: WORKSPACE -->
                <div class="ws-stat-block" id="tile-workspace" title="Click to view Workspace in Explorer">
