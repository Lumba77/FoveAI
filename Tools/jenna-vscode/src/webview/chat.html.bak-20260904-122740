          <div id="xrl-dropdown" class="persona-dropdown">
            <div class="persona-option" data-level="0">Xrl 0</div>
            <div class="persona-option" data-level="1">Xrl 1</div>
            <div class="persona-option" data-level="2">Xrl 2</div>
            <div class="persona-option" data-level="3">Xrl 3</div>
            <div class="persona-option" data-level="4">Xrl 4</div>
            <div class="persona-option" data-level="5">Xrl 5</div>
          </div>
        </div>

      </div>
    </div>

    <!-- CONTENT WRAPPER -->
    <div id="content-wrap">
      <!-- TokenSaver Stats Modal Popover -->
      <div id="stats-modal" class="modal-popover">
        <div class="flex-between-center modal-header">
          <span class="modal-title">📊 TokenSaver XRL Real-Time Statistics</span>
