        </div>



        <!-- XRL Compression Selector Dropdown -->
        <div class="persona-container">
          <button type="button" id="xrl-btn" class="hud-stat-btn" title="Change Context Compression Level (Xrl)" aria-label="Change Context Compression Level (Xrl)">
