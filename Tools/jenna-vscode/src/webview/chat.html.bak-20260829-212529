        <button type='button' id='audio-icon-btn' class='toolbar-btn' style='border-radius: 999px; padding: 5px 12px; font-size: 11px; color: #39ff14; background: rgba(57,255,20,0.08); border-color: rgba(57,255,20,0.3);' title='Push-to-talk'>PTT</button>
        <button type='button' id='continuous-icon-btn' class='toolbar-btn' style='border-radius: 999px; padding: 5px 12px; font-size: 11px; color: #ff6b6b; background: rgba(255,107,107,0.08); border-color: rgba(255,107,107,0.3);' title='Voice Activity Detection'>VAD</button>
        <button type='button' id='send-bottom-btn' class='action-btn' style='width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;' title='Send Message' aria-label='Send Message'>▶</button>
