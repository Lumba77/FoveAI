      <!-- ── Bottom rounded action bar ── -->
      <div style='display: flex; align-items: center; justify-content: center; padding: 8px 10px 0 10px; gap: 8px; flex-wrap: wrap;'>
        <button type='button' id='history-btn' class='toolbar-btn' style='border-radius: 999px; padding: 5px 12px; font-size: 12px;' title='Session history'>Mode</button>
