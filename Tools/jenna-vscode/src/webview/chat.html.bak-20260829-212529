        <button type='button' id='record-btn' class='toolbar-btn' style='border-radius: 50%; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 14px;' title='Voice Input' aria-label='Voice Input'>🎤</button>
