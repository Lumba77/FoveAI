{
  "name": "foveai-vibe-coder",
  "displayName": "FoveAI Vibe Coder",
  "description": "Persistent-memory AI vibe coder powered by FoveAI Foveated Memory — voice, context farming, repo scanning, execution buffer, and autonomous intent engine.",
  "version": "0.5.6",
  "publisher": "foveai",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "icon": "assets/jenna-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FoveAI/FoveAI-ai-agent"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jenna-panel",
          "title": "Jenna",
          "icon": "assets/jenna-activity-icon.svg"
        }
      ]
    },
    "views": {
      "jenna-panel": [
        {
          "type": "webview",
          "id": "jennaChat",
          "name": " ",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "jenna.switchPersona",
        "title": "FoveAI — Switch Active Persona",
        "icon": "$(account)"
      },
      {
        "command": "jenna.newSession",
        "title": "FoveAI — Start New Session",
        "icon": "$(add)"
      },
      {
        "command": "jenna.reloadWebview",
        "title": "FoveAI — Reload Plugin Frame",
        "icon": "$(refresh)"
      },
      {
        "command": "jenna.clearMemory",
        "title": "FoveAI — Clear Workspace Memory",
        "icon": "$(trash)"
      },
      {
        "command": "jenna.toggleStatus",
        "title": "FoveAI — Settings & Memory Status",
        "icon": "$(gear)"
      },
      {
        "command": "jenna.openSidebar",
        "title": "FoveAI — Open Sidebar",
        "icon": "$(sidebar-right)"
      },
      {
        "command": "jenna.searchMemory",
        "title": "FoveAI — Search Memory",
        "icon": "$(search)"
      },
      {
        "command": "jenna.switchModel",
        "title": "FoveAI — Switch Model",
        "icon": "$(hubot)"
      },
      {
        "command": "jenna.reloadWindow",
        "title": "FoveAI — Reload IDE Window",
        "icon": "$(sync)"
      },
      {
        "command": "jenna.sendProblemToAgent",
        "title": "🤖 Send Problem to Vibe Coder",
        "icon": "$(lightbulb)"
      },
      {
        "command": "jenna.sendAllProblemsToAgent",
        "title": "🤖 Send All Problems to Vibe Coder",
        "icon": "$(warning)"
      },
      {
        "command": "jenna.showStats",
        "title": "FoveAI — TokenSaver Statistics",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "jenna.sendProblemToAgent",
          "group": "1_modification@10"
        }
      ],
      "view/title": [
        {
          "command": "jenna.showStats",
          "when": "view == jennaChat",
          "group": "navigation@1"
        },
        {
          "command": "jenna.switchPersona",
          "when": "view == jennaChat",
          "group": "navigation@2"
        },
        {
          "command": "jenna.switchModel",
          "when": "view == jennaChat",
          "group": "navigation@3"
        },
        {
          "command": "jenna.sendAllProblemsToAgent",
          "when": "view == jennaChat",
          "group": "navigation@4"
        },
        {
          "command": "jenna.newSession",
          "when": "view == jennaChat",
          "group": "navigation@5"
        },
        {
          "command": "jenna.searchMemory",
          "when": "view == jennaChat",
          "group": "navigation@6"
        },
        {
          "command": "jenna.toggleStatus",
          "when": "view == jennaChat",
          "group": "navigation@7"
        },
        {
          "command": "jenna.clearMemory",
          "when": "view == jennaChat",
          "group": "1_actions@1"
        },
        {
          "command": "jenna.reloadWindow",
          "when": "view == jennaChat",
          "group": "1_actions@2"
        },
        {
          "command": "jenna.reloadWebview",
          "when": "view == jennaChat",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jenna.sendAllProblemsToAgent",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;",
        "when": "editorFocus || !editorFocus"
      }
    ],
    "configuration": {
      "title": "FoveAI Vibe Coder",
      "properties": {
        "FoveAI.persona": {
          "type": "string",
          "default": "code",
          "enum": [
            "code",
            "architect",
            "audit",
            "scribe",
            "test",
            "probe",
            "plan",
            "selfcode",
            "fovecode"
          ],
          "enumDescriptions": [
            "Code — Code implementation & pair programming",
            "Architect — System design & technical architecture",
            "Audit — Code review, security & bug investigation",
            "Scribe — Documentation, docstrings & specs",
            "Test — Unit testing & test suite validation",
            "Probe — Interactive requirements & design alignment",
            "Plan — Research & implementation planning",
            "SelfCode — Develop the Jenna extension & FoveAI app itself",
            "FoveCode — Maintain the main FoveAI repository"
          ],
          "description": "Active operational mode for FoveAI AI Agent"
        },
        "jenna.foveatedMemoryUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8400",
          "description": "Base URL for the FoveAI Foveated Memory proxy (port 8400)"
        },
        "jenna.model": {
          "type": "string",
          "default": "XRLF 9B (Coder)",
          "description": "Model to use for Jenna coding assistant. Default is XRLF 9B (Coder)."
        },
        "jenna.workspaceId": {
          "type": "string",
          "default": "",
          "description": "Override the workspace ID for memory isolation. Leave blank to use the workspace folder name."
        },
        "jenna.streamingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable streaming responses from Jenna"
        },
        "jenna.inlineCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Enable Jenna inline ghost-text code completions (requires port 8400)"
        },
        "foveai.xrlLevel": { "type": "number", "default": 3,
          "minimum": 0,
          "maximum": 5,
          "description": "Foveated memory compression level (0=disabled, 5=max compression)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node esbuild.config.js",
    "bundle:watch": "node esbuild.config.js --watch",
    "deploy": "node scripts/deploy_plugins.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}

