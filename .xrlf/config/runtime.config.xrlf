XRLF.3.RUNTIME.CONFIG.START

IDENTITY:
  name := FoveAI Cognitive Runtime
  version := 3.1.0
  contract := XRLF.CONTRACT.XRLF

MODEL:
  core := qwen3.5-4b-mtp-multimodal-v1.0.xrlf
  xrl_source := qwen3.5-4b
  gpu_layers := -1
  n_ctx := 8192
  capabilities := vision, audio, video, tts, xrl, foveated_memory

TRIAD:
  enabled := true
  router := xrlf_router_qwen0.5b_q4_k_m.gguf
  summarizer := xrlf_summarizer_qwen0.6b_merged.Q4_K_M.gguf
  helper_gpu_layers := 0
  router_ctx := 1024
  summarizer_ctx := 2048

API:
  host := 0.0.0.0
  port := 8402
  ws_port := 8403
  chat_endpoint := /v1/chat/completions
  health_endpoint := /health
  memory_endpoint := /v1/memory
  capabilities_endpoint := /v1/capabilities

SESSION:
  id := default
  persistent_memory := true
  compress_every := 8
  keep_verbatim := 4

TTS:
  enabled := true
  engine := auto
  provider := http
  endpoint := http://127.0.0.1:8406/tts
  voice := af_bella
  fallback := http, piper, espeak, stub

STT:
  enabled := true
  port := 8409
  model := tiny
  device := cpu
  compute_type := int8

MEMORY:
  db_source := .xrlf/memory/default/memory.db
  proxy_url := http://127.0.0.1:8400

XRLF.3.RUNTIME.CONFIG.END
