XRLF.3.AGENTS.CONFIG.START

DESCRIPTION:
  Agent role definitions — maps each agent role to its memory workspace, API key, and behavioral profile

ROLES:
  builder:
    description := Code implementation specialist — minimal change, zero-problem verification
    memory_workspace := builder
    default_model := deepseek-v4-flash:preview
    capabilities := code, debug, refactor
    token_budget_ratio := 0.6
  planner:
    description := Architecture and task decomposition — break work into checkable steps
    memory_workspace := planner
    default_model := deepseek-v4:preview
    capabilities := plan, design, analyze
    token_budget_ratio := 0.4
  reviewer:
    description := Code review and invariant validation — validate blast radius, reject works locally
    memory_workspace := reviewer
    default_model := deepseek-v4:preview
    capabilities := review, audit, validate
    token_budget_ratio := 0.3
  tester:
    description := Test execution and regression coverage — run tests, capture logs
    memory_workspace := tester
    default_model := deepseek-v4-flash:preview
    capabilities := test, monitor, report
    token_budget_ratio := 0.3
  scribe:
    description := Documentation and logging — update context.md, lessons.md
    memory_workspace := scribe
    default_model := deepseek-v4-flash:preview
    capabilities := document, summarize, log
    token_budget_ratio := 0.2

DEFAULTS:
  default_role := builder
  api_key_header := Authorization
  api_key_scheme := Bearer

XRLF.3.AGENTS.CONFIG.END
