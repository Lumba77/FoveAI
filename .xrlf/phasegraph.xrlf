XRLF.3.PHASEGRAPH.START

DESCRIPTION:
  XRLF phase graph for FoveAI refactor — strict phase ordering and transition rules

PHASES:
  phase_0_setup:
    name := Workspace Setup
    order := 0
    status := in_progress
    gates := xrlf.contract.xrlf exists, .xrlf/config/*.xrlf exist, .env paths valid
  phase_1_inventory:
    name := Service Inventory
    order := 1
    status := pending
    gates := repo-skeleton.md current, service port map validated
  phase_2_contract:
    name := Contract Alignment
    order := 2
    status := pending
    gates := all .xrlf core files present, anti-gravity steering active
  phase_3_isolation:
    name := Refactor Sandbox Isolation
    order := 3
    status := pending
    gates := Spatial_Machine_Workspace copy created, .env paths updated
  phase_4_refactor:
    name := Holonic Refactor
    order := 4
    status := pending
    gates := Diamond Concordia Holonic Architecture implemented
  phase_5_verify:
    name := Zero-Problem Verification
    order := 5
    status := pending
    gates := tsc --noEmit passes, tests pass, no regressions

TRANSITIONS:
  0 -> 1: setup_complete
  1 -> 2: inventory_complete
  2 -> 3: contract_aligned
  3 -> 4: sandbox_ready
  4 -> 5: refactor_complete
  5 -> done: verified

XRLF.3.PHASEGRAPH.END
