"""Generate ScreenWatch.ts and CodeAgency.ts"""
import os
base = r"c:\Users\danie\Program\LUMAX\Frontend\XR_Vessel\src\senses"

# Write ScreenWatch.ts via base64 to avoid escape issues
import base64

sw_b64 = ""

with open(os.path.join(base, 'ScreenWatch.ts'), 'wb') as f:
    f.write(base64.b64decode(sw_b64))

# Write CodeAgency.ts
