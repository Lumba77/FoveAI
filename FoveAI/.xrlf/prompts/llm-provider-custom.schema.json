{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LUMAX Custom LLM Provider — XLR Skeleton Schema",
  "description": "Machine-readable schema for the custom OpenAI-compatible LLM provider configuration, derived from .env:365-366 and xrl-compressor.js ring compression levels.",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "const": "custom",
      "description": "LUMAX_LLM_PROVIDER value — indicates custom OpenAI-compatible format"
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string",
          "description": "LUMAX_BASE_URL — OpenAI-compatible base URL"
        },
        "path": {
          "type": "string",
          "const": "/chat/completions",
          "description": "Chat completions endpoint path"
        },
        "full_url": {
          "type": "string",
          "description": "Concatenated base_url + path"
        }
      },
      "required": ["base_url", "path"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string",
          "const": "Authorization"
        },
        "scheme": {
          "type": "string",
          "const": "Bearer"
        },
        "key_env": {
          "type": "string",
          "const": "LUMAX_API_KEY"
        }
      },
      "required": ["header", "scheme", "key_env"]
    },
    "models": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "description": "LUMAX_MODEL_ID — main model identifier"
        },
        "cloud_fallback": {
          "type": "string",
          "description": "LUMAX_CLOUD_MODEL — cloud fallback model"
        },
        "compressor": {
          "type": "string",
          "description": "LUMAX_COMPRESSOR_MODEL — smart router for compression"
        },
        "compressor_no2": {
          "type": "string",
          "description": "LUMAX_COMPRESSOR_MODEL_NO2 — secondary smart router"
        },
        "receiver": {
          "type": "string",
          "description": "LUMAX_RECIEVER_MODEL — receiver model"
        },
        "delegator": {
          "type": "string",
          "description": "LUMAX_DELEGATOR_MODEL — delegator model"
        },
        "summarizer": {
          "type": "string",
          "description": "LUMAX_SUMMARIZER_MODEL — LLM summarizer for ring compression"
        },
        "cpu_only": {
          "type": "array",
          "items": { "type": "string" },
          "description": "LUMAX_CPU_ONLY_MODELS — models forced to CPU to free VRAM"
        }
      },
      "required": ["primary", "cloud_fallback"]
    },
    "request_format": {
      "type": "object",
      "description": "OpenAI Chat Completions compatible request body",
      "properties": {
        "model": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["system", "user", "assistant"] },
              "content": { "type": "string" }
            },
            "required": ["role", "content"]
          }
        },
        "stream": { "type": "boolean", "default": true },
        "temperature": { "type": "number", "default": 0.7 }
      },
      "required": ["model", "messages"]
    },
    "xrl_compression": {
      "type": "object",
      "description": "Foveated memory ring compression configuration from xrl-compressor.js",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "LUMAX_LLM_SUMMARIZE — enable LLM-based summarization"
        },
        "summarizer_url": {
          "type": "string",
          "description": "LM_STUDIO_URL — local summarizer endpoint"
        },
        "rings": {
          "type": "array",
          "description": "6-level foveated compression rings",
          "items": {
            "type": "object",
            "properties": {
              "level": { "type": "integer", "minimum": 0, "maximum": 5 },
              "name": { "type": "string" },
              "compression": { "type": "string" },
              "method": { "type": "string" },
              "output_format": { "type": "string" }
            },
            "required": ["level", "name", "compression", "method"]
          }
        },
        "token_budget": {
          "type": "integer",
          "default": 999,
          "description": "Default token budget for compression"
        },
        "hash_format": {
          "type": "string",
          "pattern": "^xrl://mem/[a-f0-9]{4}$",
          "description": "XRL memory hash format (4-char MD5 prefix)"
        }
      },
      "required": ["enabled", "rings"]
    }
  },
  "required": ["provider", "endpoint", "auth", "models", "request_format", "xrl_compression"]
}