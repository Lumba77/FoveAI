{
  "name": "lumax-solver",
  "version": "3.0.0",
  "description": "AI-powered error solver. Paste any terminal error — get a working fix. Installs a local guardian that auto-repairs your projects in the background.",
  "type": "module",
  "bin": {
    "lumax-solver": "./bin/lumax-solver.js"
  },
  "main": "./lumax-solver.js",
  "exports": {
    ".": "./lumax-solver.js",
    "./setup": "./src/setup.js",
    "./service": "./src/service-install.js"
  },
  "files": [
    "bin/",
    "src/",
    "lumax-solver.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bin/lumax-solver.js",
    "setup": "node bin/lumax-solver.js setup",
    "serve": "node bin/lumax-solver.js serve",
    "test": "node --check bin/lumax-solver.js && node --check src/solver.js && node --check src/setup.js"
  },
  "keywords": [
    "ai", "llm", "error", "debugger", "fix", "gemini", "ollama",
    "cli", "solver", "terminal", "repair", "lumax"
  ],
  "author": "LUMAX Project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumax/lumax-solver"
  },
  "dependencies": {},
  "devDependencies": {}
}
