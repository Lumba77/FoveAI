<?xml version="1.0" encoding="UTF-8"?>
<xrlf_steering version="3.0">
  <contract>
    <file>xrlf.contract.xrlf</file>
    <fallback>.xrlf/xrlf.contract.xrlf</fallback>
  </contract>
  <workspace>
    <root_env>XRLF_WORKSPACE_ROOT</root_env>
    <mode_env>XRLF_RUNTIME_MODE</mode_env>
    <agent_env>XRLF_AGENT_ID</agent_env>
  </workspace>
  <memory>
    <proxy>http://127.0.0.1:8400</proxy>
    <compress_every>8</compress_every>
    <keep_verbatim>4</keep_verbatim>
  </memory>
  <anti_gravity>
    <ide_folder>.antigravityIDE</ide_folder>
    <steering_folder>.antigravity</steering_folder>
    <note>Use .antigravityIDE for IDE binaries; use .antigravity for XRLF steering only.</note>
  </anti_gravity>
  <authoritative_files>
    <file>repo-skeleton.md</file>
    <file>uptodate.md</file>
    <file>context.md</file>
    <file>ARCHITECTURE.md</file>
    <file>LUMAX.md</file>
    <file>WORKFLOW.md</file>
  </authoritative_files>
  <rules>
    <rule>Read repo-skeleton.md first at session start</rule>
    <rule>Use TokenSlayer MCP analyze_files before reading source files</rule>
    <rule>Zero-problem verification before marking done</rule>
    <rule>Windows-native only: no Docker, no WSL2, no Godot</rule>
    <rule>Log every successful task in context.md</rule>
  </rules>
</xrlf_steering>
