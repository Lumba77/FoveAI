##### ---| FoveAI Workspace |--- #####
##### ---| Fedora/Linux local runtime  |--- #####

# Force HuggingFace to use local cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# HF cache on Dev-NTFS (not inside FoveAI repo)
HF_HOME=/home/lumba/Models/HF
HF_HUB_CACHE=/home/lumba/Models/hub
TRANSFORMERS_CACHE=/home/lumba/Models/hub
# Linux system CA bundle (Cloudflare WARP not used on this host)
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# XRLF Workspace Root
XRLF_WORKSPACE_ROOT=/home/lumba/FoveAI
LD_LIBRARY_PATH=/home/lumba/FoveAI/.venv/lib/python3.12/site-packages/nvidia/cu13/lib:/home/lumba/FoveAI/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/home/lumba/FoveAI/.venv/lib/python3.12/site-packages/torch/lib

# XRLF Contract Path
XRLF_CONTRACT_PATH=/home/lumba/FoveAI/XRLF.CONTRACT.XRLF

# XRLF Agent Identity
XRLF_AGENT_ID=FoveAI_Agent_01

# XRLF Runtime Mode
XRLF_RUNTIME_MODE=local
XRLF_COGNITIVE_MODE=local
XRLF_MODEL_LOCAL_ID=qwopus3.5-9b-coder-mtp-moq.xrlf

# XRLF Foveated Memory Proxy
XRLF_MEMORY_PROXY_URL=http://127.0.0.1:8400

# Web UI
FoveAI_WEBUI_ALLOW_INSECURE=0
FoveAI_WEBUI_PASSWORD=Vee+-++1*hhW
WEBUI_PORT=8101

# XRLF Context Reactor (foveated memory compression + context healing)
XRLF_REPO_ENABLED=true
XRLF_CONTEXT_OVERRIDE=true
XRLF_PROXY_MODE=routing
XRLF_FOVEATION_OVERRIDE=true
XRLF_CTX_MAX_CHARS=16000
XRLF_CTX_MIN_CHARS=4000

# Soul API — compagent serves persona/DNA/presets on :8405 (foveai-soul.service)
SOUL_PORT=8405
SOUL_URL=http://127.0.0.1:8405

# XRLF Phase Graph Mode
XRLF_PHASE_GRAPH_MODE=strict

# XRLF Geometry Mode
XRLF_GEOMETRY_MODE=hybrid

# XRLF Thermal Limit (percent)
XRLF_THERMAL_LIMIT=85

# XRLF Auto Refactor
XRLF_AUTO_REFRACTOR=true

# XRLF Holonic Schema Path
XRLF_HOLON_SCHEMA_PATH=/home/lumba/FoveAI/.xrlf/holons.xrlf

# XRLF Phase Graph Path
XRLF_PHASE_GRAPH_PATH=/home/lumba/FoveAI/.xrlf/phasegraph.xrlf

# XRLF Agents Definition Path
XRLF_AGENTS_PATH=/home/lumba/FoveAI/.xrlf/agents.xrlf

# XRLF Extensions Directory
XRLF_EXTENSIONS_DIR=/home/lumba/FoveAI/.xrlf/extensions

# XRLF Config Directory
XRLF_CONFIG_DIR=/home/lumba/FoveAI/.xrlf/config

# XRLF Geometry Config
XRLF_GEOMETRY_CONFIG=/home/lumba/FoveAI/.xrlf/config/geometry.config.xrlf

# XRLF Resonance Config
XRLF_RESONANCE_CONFIG=/home/lumba/FoveAI/.xrlf/config/resonance.config.xrlf

# XRLF Thermal Config
XRLF_THERMAL_CONFIG=/home/lumba/FoveAI/.xrlf/config/thermal.config.xrlf

# XRLF Runtime Config
XRLF_RUNTIME_CONFIG=/home/lumba/FoveAI/.xrlf/config/runtime.config.xrlf

# XRLF Agents Config
XRLF_AGENTS_CONFIG=/home/lumba/FoveAI/.xrlf/config/agents.config.xrlf

##### ---| FoveAI Backend Connection (Biological Cycle) |--- #####

# ── Single source of truth for network addresses ──
FOVEAI_BIND_HOST=0.0.0.0
FOVEAI_SERVER_IP=

# ── Port scheme: 8400 = Memory, 8402 = Soul, 8403 = WebSocket IPC ──
FOVEAI_WS_PORT=8403
FOVEAI_BACKEND_START_WS=true
FOVEAI_LEGACY_WS_PORT=8400

# Core cognitive servers
FOVEAI_COMPAGENT_PORT=8405
SOUL_PORT=8405
FOVEAI_AUTONOMOUS_PORT=8410
FOVEAI_MOTOR_PORT=8410
FOVEAI_SUBCONSCIOUS_PORT=8409

# Service servers
FOVEAI_CREATIVE_PORT=8412
FOVEAI_MEMORY_PORT=8413

# XRLF Speculative Decoding (MTP) — disabled (CUDA VMM pool crash on 0.3.34)
XRLF_SPECULATIVE_DECODING=false

# Triad pipeline (router + summarizer on CPU, zero VRAM impact)
XRLF_TRIAD_PIPELINE=true
XRLF_ROUTER_GGUF=/home/lumba/Training/outputs/xrlf_router_qwen0.5b_q4_k_m.gguf
XRLF_SUMMARIZER_GGUF=/home/lumba/Training/outputs/xrlf_summarizer_qwen0.6b_merged_gguf/xrlf_summarizer_qwen0.6b_merged.Q4_K_M.gguf

# STT
STT_PORT=8401
STT_MODEL=small.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# TTS
FOVEAI_TTS_PORT=8411

# XRLF API
FOVEAI_XRLF_API_PORT=8300

# Derived URL
FOVEAI_BACKEND_URL=

