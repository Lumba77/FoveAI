{
  "mcpServers": {
    "lumax-memory": {
      "autoApprove": [
        "get_memory",
        "search_memory",
        "get_session_context",
        "import_history",
        "get_sources",
        "import_doc",
        "search_docs",
        "list_docs",
        "index_directory",
        "assess_directory",
        "search_codebase",
        "list_indexed",
        "summarize_context",
        "compress_search_results",
        "check_local_llm",
        "start_middleman"
      ],
      "timeout": 60,
      "command": ".venv/Scripts/python.exe",
      "args": [
        "Backend/Memory/lumax_mcp_server.py"
      ],
      "env": {
        "LUMAX_ROOT": "C:/Users/danie/program/LUMAX",
        "LOCAL_LLM_BASE": "http://localhost:7272/v1",
        "LOCAL_LLM_MODEL": "qwen2.5-0.5b-instruct",
        "LOCAL_LLM_GPU_OFFLOAD": "max",
        "LOCAL_LLM_TIMEOUT": "60",
        "LUMAX_MCP_CONTEXT": "true"
      },
      "type": "stdio",
      "disabled": false
    },
    "tokenslayer": {
      "autoApprove": [
        "analyze_files",
        "analyze_workspace",
        "analyze_dependency_chain",
        "expand_node",
        "get_stats",
        "session_health"
      ],
      "timeout": 120,
      "command": "node",
      "args": [
        "Forge/scratch/TokenSlayer/mcp-server/build/index.js"
      ],
      "env": {
        "LUMAX_ROOT": "C:/Users/danie/program/LUMAX"
      },
      "type": "stdio",
      "disabled": false
    },
    "xrl": {
      "autoApprove": [
        "load_xrl",
        "expand_xrl",
        "search_xrl"
      ],
      "timeout": 60,
      "command": "node",
      "args": [
        "Tools/lumax-xrl/xrs/xrl-mcp-server.cjs"
      ],
      "env": {
        "LUMAX_ROOT": "C:/Users/danie/program/LUMAX"
      },
      "type": "stdio",
      "disabled": false
    }
  }
}