def _validate_ts_content(data: bytes, filename: str) -> bool:
    """Check that decoded content looks like valid TypeScript source.

    Returns True if the content passes basic sanity checks.
    """
    if len(data) < MIN_EXPECTED_SIZE:
        log.warning(
            "%s: decoded size %d bytes (< %d minimum) — may be corrupted",
            filename, len(data), MIN_EXPECTED_SIZE,
        )
        return False

    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        log.error("%s: decoded content is not valid UTF-8", filename)
        return False

    # Quick heuristic: TypeScript files should contain at least one of these
    ts_markers = ("export ", "import ", "interface ", "class ", "function ", "const ")
    if not any(marker in text for marker in ts_markers):
        log.warning(
            "%s: no TypeScript markers found — may not be valid TS source",
            filename,
        )
        return False

    return True


def _atomic_write(filepath: Path, data: bytes) -> None:
    """Write data to filepath atomically using a temp-file + rename strategy.

    On Windows, the destination is removed first if it exists, because
    os.replace() on Windows requires the target to not exist (or be a
    directory replacement).
    """
    tmp_fd, tmp_path = tempfile.mkstemp(
        dir=str(filepath.parent),
        prefix=f".{filepath.name}.",
        suffix=".tmp",
    )
    try:
        # Write to the temp file via its file descriptor
        with os.fdopen(tmp_fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())

        # On Windows, remove the destination first if it exists
        if sys.platform == "win32" and filepath.exists():
            filepath.unlink()

        # Atomic rename (works cross-platform)
        Path(tmp_path).replace(filepath)
    except Exception:
        # Clean up temp file on failure
        Path(tmp_path).unlink(missing_ok=True)
        raise


def deploy_modules(
    target_dir: Path,
    modules: Dict[str, str],
    *,
    dry_run: bool = False,
    force: bool = False,
) -> int:
    """Decode and write all embedded TypeScript modules.

    Args:
        target_dir: Destination directory for the .ts files.
        modules: Mapping of filename → base64-encoded content.
        dry_run: If True, validate only — do not write files.
        force: If True, skip content validation and write anyway.

    Returns:
        The number of modules successfully deployed.
    """
    # --- Pre-flight: ensure target directory exists and is writable ---
    if not dry_run:
        try:
            target_dir.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            log.error("Cannot create target directory %s: %s", target_dir, exc)
            return 0

        if not target_dir.is_dir():
            log.error("Target path exists but is not a directory: %s", target_dir)
            return 0

        # Write-permission check
        probe = target_dir / ".deploy_write_test"
        try:
            probe.touch()
            probe.unlink()
        except OSError as exc:
            log.error(
                "Target directory is not writable: %s (%s)", target_dir, exc
            )
            return 0

    deployed = 0
    failed: list[str] = []

    for filename, b64_content in modules.items():
        filepath = target_dir / filename

        # --- Decode ---
        try:
            decoded = base64.b64decode(b64_content)
        except Exception as exc:
            log.error("%s: base64 decode failed — %s", filename, exc)
            failed.append(filename)
            continue

        # --- Validate ---
        valid = _validate_ts_content(decoded, filename)
        if not valid and not force:
            log.error(
                "%s: validation failed — use --force to write anyway", filename
            )
            failed.append(filename)
            continue
        elif not valid and force:
            log.warning("%s: writing despite validation warning (--force)", filename)

        if dry_run:
            log.info(
                "  [DRY-RUN] %s: %d bytes (%s)",
                filename,
                len(decoded),
                "validated" if valid else "WARNINGS",
            )
            deployed += 1
            continue

        # --- Atomic write ---
        try:
            _atomic_write(filepath, decoded)
        except OSError as exc:
            log.error("%s: write failed — %s", filename, exc)
            log.debug("%s", traceback.format_exc())
            failed.append(filename)
            continue

        size = filepath.stat().st_size
        log.info("  OK  %s: %d bytes", filename, size)
        deployed += 1

    # --- Summary ---
    total = len(modules)
    if failed:
        log.warning(
            "%d/%d modules deployed successfully; %d failed: %s",
            deployed, total, len(failed), ", ".join(failed),
        )
    else:
        log.info("All %d modules deployed successfully.", deployed)

    return deployed


def main(argv: list[str] | None = None) -> int:
    """Entry point.

    Returns:
        0 — all modules deployed successfully.
        1 — partial failure (some modules deployed).
        2 — total failure (no modules deployed).
    """
    import argparse

    parser = argparse.ArgumentParser(
        description="Deploy embedded TypeScript sense modules to the XR Vessel frontend.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate all modules without writing any files.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Skip content validation and write files anyway.",
    )
    parser.add_argument(
        "--target",
        type=Path,
        default=None,
        help="Override target directory (default: <script_dir>/Frontend/XR_Vessel/src/senses).",
    )
    args = parser.parse_args(argv)

    # Resolve target directory
    if args.target is not None:
        target_dir = args.target.resolve()
    else:
        script_dir = Path(__file__).resolve().parent
        target_dir = script_dir.joinpath(*TARGET_SUBDIR)

    log.info("Target directory: %s", target_dir)
    if args.dry_run:
        log.info("DRY-RUN mode — no files will be written.")
    if args.force:
        log.info("FORCE mode — validation warnings will be ignored.")

    count = deploy_modules(
        target_dir, MODULES_B64, dry_run=args.dry_run, force=args.force,
    )

    if count == 0:
        log.error("No modules were deployed.")
        return 2
    if count < len(MODULES_B64):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
