{
  "xrlf_version": "1.0",
  "format_version": 1,
  "model": {
    "core": "gemma-4-12b-it-qat-GGUF-MoQ",
    "xrl_source": "qwen3.5-4b",
    "gpu_layers": -1,
    "n_ctx": 8192,
    "capabilities": {
      "input": {
        "text": { "native": true, "hook": null },
        "image": { "native": true, "hook": null },
        "video": { "native": true, "hook": null },
        "audio": { "native": true, "hook": null }
      },
      "output": {
        "text": { "native": true, "hook": null },
        "speech": { "native": false, "hook": "tts" },
        "image": { "native": false, "hook": "image_gen" },
        "audio": { "native": false, "hook": "audio_gen" }
      }
    }
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8400,
    "endpoints": {
      "chat": "/v1/chat/completions",
      "health": "/health",
      "memory": "/v1/memory"
    }
  },
  "session": {
    "id": "default",
    "persistent_memory": true,
    "compress_every": 8,
    "keep_verbatim": 4
  },
  "tts": {
    "enabled": true,
    "engine": "auto",
    "provider": "http",
    "endpoint": "http://127.0.0.1:8004/tts",
    "voice": "default",
    "fallback": ["http", "piper", "espeak", "stub"]
  },
  "gguf_source": "",
  "memory_db_source": ".xrlf/memory/default/memory.db"
}