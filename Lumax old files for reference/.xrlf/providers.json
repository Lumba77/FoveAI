    "fovea_local": {
      "type": "openai_compatible",
      "base_url": "http://127.0.0.1:1234/v1",
      "api_key": "not-needed",
      "default_model": "qwen3.5-4b",
      "context_window": 4096,
      "description": "Fovea compression via local LM Studio"
