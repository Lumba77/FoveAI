XRLF.3.RESONANCE.CONFIG.START

DESCRIPTION:
  Resonance tuning — model parameters, steering strength, and behavioral calibration

XRL:
  steering_strength := 0.8
  profile_auto_detect := true
  verbose := false

MEMORY:
  token_budget := 2048
  tfidf_top_k := 5
  embedding_model := qwen3.5-4b

TTS:
  enabled := true
  engine := auto
  provider := http
  endpoint := http://127.0.0.1:8004/tts
  voice := default
  fallback := http, piper, espeak, stub

BEHAVIORAL:
  temperature := 0.7
  top_p := 0.9
  top_k := 40
  repeat_penalty := 1.1
  max_tokens := 4096
  stop_sequences := [USER_STOP, <|endoftext|>]

CHECKPOINT:
  lm_studio_endpoint := http://127.0.0.1:7272/v1
  compression_model := qwen3.5-4b
  fallback_strategy := extractive

XRLF.3.RESONANCE.CONFIG.END
