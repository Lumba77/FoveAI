{
  "mcpServers": {
    "foveai-memory": {
      "autoApprove": [
        "get_memory",
        "search_memory",
        "get_session_context",
        "import_history",
        "get_sources",
        "import_doc",
        "search_docs",
        "list_docs",
        "index_directory",
        "assess_directory",
        "search_codebase",
        "list_indexed",
        "summarize_context",
        "compress_search_results",
        "check_local_llm"
      ],
      "timeout": 60,
      "command": "/home/lumba/FoveAI/.venv/bin/python",
      "args": [
        "-B",
        "/home/lumba/FoveAI/Backend/Memory/foveai_mcp_server.py"
      ],
      "env": {
        "FoveAI_REPO_ROOT": "/home/lumba/FoveAI",
        "FOVEAI_MCP_CONTEXT": "0",
        "FOVEAI_MCP_MAX_CONTEXT_TOKENS": "800"
      },
      "type": "stdio",
      "disabled": false,
      "alwaysAllow": []
    },
    "foveated-memory": {
      "autoApprove": [
        "memory_save",
        "memory_recall",
        "memory_recent",
        "memory_summary",
        "memory_stats",
        "foveai_status",
        "foveai_models",
        "foveai_sessions"
      ],
      "timeout": 60,
      "command": "node",
      "args": [
        "/home/lumba/FoveAI/foveated-memory/mcp-server.js"
      ],
      "env": {
        "FM_PROXY_URL": "http://127.0.0.1:8400"
      },
      "type": "stdio",
      "disabled": false,
      "alwaysAllow": []
    },
    "nvidia-nim": {
      "autoApprove": [
        "nvidia_list_models"
      ],
      "timeout": 120,
      "command": "/home/lumba/FoveAI/.venv/bin/python",
      "args": [
        "-B",
        "/home/lumba/FoveAI/Tools/nvidia-mcp/server.py"
      ],
      "type": "stdio",
      "disabled": false,
      "alwaysAllow": []
    },
    "tokenslayer": {
      "autoApprove": [
        "analyze_files",
        "analyze_workspace",
        "analyze_dependency_chain",
        "expand_node",
        "get_stats",
        "session_health"
      ],
      "timeout": 120,
      "command": "node",
      "args": [
        "Forge/scratch/TokenSlayer/mcp-server/build/index.js"
      ],
      "env": {
        "LUMAX_ROOT": "/home/lumba/FoveAI"
      },
      "type": "stdio",
      "disabled": false,
      "alwaysAllow": [
        "get_stats",
        "session_health",
        "analyze_workspace",
        "expand_node",
        "analyze_files"
      ]
    }
  }
}
