{
  "mcpServers": {
    "lumax-memory": {
      "autoApprove": [
        "get_memory",
        "search_memory",
        "get_session_context",
        "import_history",
        "get_sources",
        "import_doc",
        "search_docs",
        "list_docs",
        "index_directory",
        "assess_directory",
        "search_codebase",
        "list_indexed",
        "summarize_context",
        "compress_search_results",
        "check_local_llm",
        "start_middleman"
      ],
      "timeout": 60,
      "command": ".venv/Scripts/python.exe",
      "args": [
        "backend/Memory/lumax_mcp_server.py"
      ],
      "env": {
        "LUMAX_ROOT": "C:/Users/danie/program/LUMAX",
        "LOCAL_LLM_BASE": "http://localhost:8888/v1",
        "LOCAL_LLM_MODEL": "qwen3.5-2b-abliterated",
        "LOCAL_LLM_GPU_OFFLOAD": "0.2",
        "LOCAL_LLM_TIMEOUT": "60",
        "LUMAX_MCP_CONTEXT": "true"
      },
      "type": "stdio",
      "disabled": true,
      "alwaysAllow": []
    },
    "tokenslayer": {
      "autoApprove": [
        "analyze_files",
        "analyze_workspace",
        "analyze_dependency_chain",
        "expand_node",
        "get_stats",
        "session_health"
      ],
      "timeout": 120,
      "command": "node",
      "args": [
        "Forge/scratch/TokenSlayer/mcp-server/build/index.js"
      ],
      "env": {
        "LUMAX_ROOT": "C:/Users/danie/program/LUMAX"
      },
      "type": "stdio",
      "disabled": false,
      "alwaysAllow": [
        "get_stats",
        "session_health",
        "analyze_workspace",
        "expand_node",
        "analyze_files"
      ]
    }
  }
}