[Unit]
Description=x11vnc bridge for physical X11 display :0
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/x11vnc -display :0 -auth %h/.Xauthority -localhost -forever -shared -norepeat -clear_all -noxdamage -rfbport 5900 -nopw
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
