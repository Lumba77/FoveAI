{
  "manifest_version": 3,
  "name": "LUMAX Life Bridge",
  "version": "1.0.0",
  "description": "System integrator and Dev Bridge for the LUMAX WebXR Vessel.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open LUMAX Control Panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:*/*", "https://lumax.1um6a.se/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini_integrator.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "identity",
    "activeTab",
    "scripting",
    "sidePanel",
    "nativeMessaging"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://lumax.1um6a.se/*",
    "https://lumax.1um6a.se:8009/*",
    "https://www.googleapis.com/*",
    "https://gemini.google.com/*"
  ]
}