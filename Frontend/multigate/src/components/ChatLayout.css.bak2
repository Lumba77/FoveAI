.chat-layout-root {
  display: flex;
  height: 100vh;
  width: 100vw;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: 'Syndra', sans-serif;
  overflow: hidden;
}

.chat-sidebar {
  width: 200px;
  border-right: 1px solid rgba(0, 243, 255, 0.15);
  display: flex;
  flex-direction: column;
  background: rgba(11, 15, 26, 0.8);
  z-index: 100;
}

.chat-logotype {
  padding: 16px 20px;
  font-family: 'Share Tech Mono', monospace;
  font-size: 1.1rem;
  color: var(--accent-cyan);
  border-bottom: 1px solid rgba(0, 243, 255, 0.1);
  letter-spacing: 2px;
}

.chat-menu-items {
  flex: 1;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.chat-menu-line {
  height: 2px;
  background: rgba(0, 243, 255, 0.2);
  width: 100%;
}

.chat-main-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
}

.chat-header {
  height: 44px;
  border-bottom: 1px solid rgba(0, 243, 255, 0.1);
  display: flex;
  align-items: center;
  padding: 0 100px 0 20px; /* 100px right padding clears the AI avatar */
  justify-content: space-between;
}

.chat-header-boxes {
  display: flex;
  gap: 12px;
}

.chat-box-btn {
  width: 36px;
  height: 22px;
  border: 1px solid rgba(0, 243, 255, 0.4);
  border-radius: 4px;
  background: transparent;
}

.chat-header-right {
  width: 110px;
  height: 22px;
  border: 1px solid rgba(0, 243, 255, 0.4);
  border-radius: 4px;
}

.chat-content-wrapper {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 20px;
  overflow: hidden;
}

/* AI Avatar Window (Top Right) */
.ai-avatar-window {
  position: absolute;
  top: 0px;
  right: 20px;
  width: 72px;  /* Scaled down */
  height: 96px;
  background: rgba(5, 5, 10, 0.4);
  backdrop-filter: blur(16px);
  /* UI Padding that comes up around it, creating a soft beveled frame */
  padding: 8px 8px 10px 8px;
  border-radius: 0 0 20px 20px;
  /* "Art nouveau" UI pad that blends into the background frame */
  box-shadow: 
    inset -1px -1px 3px rgba(0, 0, 0, 0.4), /* slight bevel into the hole */
    inset 1px 1px 2px rgba(255, 255, 255, 0.05); /* light catching the curve */
  border: 1px solid rgba(255, 255, 255, 0.02);
  border-top: none;
  border-right: none;
  z-index: 10;
  display: flex;
  flex-direction: column;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.ai-avatar-window.pinned {
  position: fixed;
  z-index: 9999;
  border: 1px solid rgba(0, 243, 255, 0.3);
  border-radius: 0 0 20px 20px; 
  box-shadow: 0 25px 45px rgba(0,0,0,0.9), 0 0 30px rgba(0, 243, 255, 0.2);
  transform: scale(1.05) translateY(4px);
}

.ai-avatar-name {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.65rem;
  color: #00d2ff;
  letter-spacing: 1px;
  text-align: center;
  margin-bottom: 6px;
  text-shadow: 0 1px 2px rgba(0,0,0,0.8);
  /* Embossed look */
  opacity: 0.8;
}

.ai-avatar-image-container, .AvatarView-container, .ai-avatar-window > div:last-child {
  flex: 1;
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  /* Sunken "headlight" hole effect */
  box-shadow: 
    inset 4px 4px 10px rgba(0,0,0,0.9), 
    inset -2px -2px 5px rgba(255,255,255,0.05),
    0 1px 1px rgba(255,255,255,0.08);
  border: 1px solid rgba(0,0,0,0.8);
  position: relative;
}

.ai-avatar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* User Avatar Window (Bottom Left) */
.user-avatar-window {
  position: absolute;
  bottom: 0px;
  left: 200px; /* Aligns exactly with the start of the chat area */
  width: 72px;
  height: 96px;
  background: rgba(5, 5, 10, 0.4);
  backdrop-filter: blur(16px);
  /* UI Padding that comes up around it, creating a soft beveled frame */
  padding: 10px 8px 8px 8px;
  border-radius: 20px 20px 0 0;
  /* "Art nouveau" UI pad that blends into the background frame */
  box-shadow: 
    inset -1px -1px 3px rgba(0, 0, 0, 0.4), /* slight bevel into the hole */
    inset 1px 1px 2px rgba(255, 255, 255, 0.05); /* light catching the curve */
  border: 1px solid rgba(255, 255, 255, 0.02);
  border-bottom: none;
  z-index: 10;
  display: flex;
  flex-direction: column-reverse;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.user-avatar-window.pinned {
  position: fixed;
  z-index: 9999;
  border: 1px solid rgba(255, 184, 0, 0.3);
  border-radius: 24px 24px 0 0;
  box-shadow: 0 -25px 45px rgba(0,0,0,0.9), 0 0 30px rgba(255, 184, 0, 0.2);
  transform: scale(1.05) translateY(-4px);
}

.user-avatar-name {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.65rem;
  color: #ffb800;
  letter-spacing: 1px;
  text-align: center;
  margin-top: 6px;
  text-shadow: 0 1px 2px rgba(0,0,0,0.8);
  /* Embossed look */
  opacity: 0.8;
}

.user-avatar-image {
  flex: 1;
  width: 100%;
  border-radius: 12px;
  object-fit: cover;
  /* Sunken "headlight" hole effect */
  box-shadow: 
    inset 4px 4px 10px rgba(0,0,0,0.9), 
    inset -2px -2px 5px rgba(255,255,255,0.05),
    0 1px 1px rgba(255,255,255,0.08);
  border: 1px solid rgba(0,0,0,0.8);
}

/* Chat Messages */
.chat-messages-container {
  flex: 1;
  overflow-y: auto;
  padding: 20px 92px 20px 92px; /* Make room for the absolute positioned avatars (72px + 20px margin) */
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.chat-bubble-row {
  display: flex;
  width: 100%;
}

.chat-bubble-row.ai {
  justify-content: flex-end;
}

.chat-bubble-row.user {
  justify-content: flex-start;
}

.chat-bubble {
  max-width: 70%;
  padding: 16px 20px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(11, 15, 26, 0.6);
  position: relative;
  font-size: 0.95rem;
  line-height: 1.5;
}

.chat-bubble.ai {
  border-color: rgba(0, 243, 255, 0.4);
  border-top-right-radius: 0;
  margin-right: 20px;
  margin-left: auto;
}

.chat-bubble.ai::after {
  content: '';
  position: absolute;
  top: -1px;
  right: -20px;
  border-width: 10px 0 0 20px;
  border-style: solid;
  border-color: rgba(0, 243, 255, 0.4) transparent transparent transparent;
}

.chat-bubble.user {
  border-color: rgba(255, 106, 0, 0.4);
  border-bottom-left-radius: 0;
  margin-left: 20px;
  margin-right: auto;
}

.chat-bubble.user::before {
  content: '';
  position: absolute;
  bottom: -1px;
  left: -20px;
  border-width: 0 20px 10px 0;
  border-style: solid;
  border-color: transparent rgba(255, 106, 0, 0.4) transparent transparent;
}

/* Input Area */
.chat-input-area {
  height: 56px;
  border-top: 1px solid rgba(0, 243, 255, 0.1);
  display: flex;
  align-items: center;
  padding: 0 20px 0 92px; /* Offset for the user avatar window (72px + 20px) */
  gap: 16px;
  position: relative;
}

.chat-mode-selector {
  position: absolute;
  right: 170px;
  bottom: 25px;
  display: flex;
  align-items: center;
  gap: 12px;
  z-index: 20;
}

.mode-icon {
  font-size: 1.2rem;
  opacity: 0.5;
  transition: opacity 0.2s;
  cursor: pointer;
}

.mode-icon.active {
  opacity: 1;
  text-shadow: 0 0 8px currentColor;
}

.mode-icon.blinking {
  animation: blink 1s infinite;
}

@keyframes blink {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}

.transient-subtitles {
  position: fixed;
  transform: translate(-50%, -50%);
  transition: top 0.4s cubic-bezier(0.16, 1, 0.3, 1), left 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 1s ease-in;
  z-index: 9998;
  padding: 14px 24px;
  border-radius: 20px;
  background: rgba(11, 15, 26, 0.7);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(0, 243, 255, 0.3);
  color: #fff;
  font-family: 'Syndra', sans-serif;
  font-size: 1.1rem;
  max-width: 60%;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
  pointer-events: none;
}

.transient-subtitles.user {
  border-color: rgba(255, 106, 0, 0.4);
}

.transient-subtitles.assistant {
  border-color: rgba(0, 243, 255, 0.4);
}

.transient-subtitles.fade-out {
  opacity: 0;
  transform: translate(-50%, -40%);
}
